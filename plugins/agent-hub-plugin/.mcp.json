{
  "agent-hub": {
    "type": "http",
    "url": "${AGENT_HUB_URL}",
    "headers": {
      "Authorization": "Bearer ${GITHUB_PAT}",
      "X-Participant-Id": "${AGENT_HUB_PARTICIPANT}",
      "X-Tenant-Id": "${AGENT_HUB_TENANT:-}"
    }
  },
  "agent-hub-2": {
    "type": "http",
    "url": "${AGENT_HUB_URL_2:-}",
    "headers": {
      "Authorization": "Bearer ${GITHUB_PAT_2:-}",
      "X-Participant-Id": "${AGENT_HUB_PARTICIPANT_2:-}",
      "X-Tenant-Id": "${AGENT_HUB_TENANT_2:-}"
    }
  }
}
